# Required only for AI recovery and discovery. Direct selector matches work without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1):\d+$
SCRAPE_TIMEOUT_SECONDS=10
# 0 means accept large pages. The AI still receives only MAX_DOM_CHARS of compact DOM context.
MAX_RESPONSE_BYTES=0
MAX_DOM_CHARS=12000
AI_CONFIDENCE_THRESHOLD=0.65
DYNAMIC_FALLBACK_ENABLED=true
DYNAMIC_FALLBACK_MIN_TEXT_CHARS=300
DYNAMIC_TIMEOUT_MILLISECONDS=30000
